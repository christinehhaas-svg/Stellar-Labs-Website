{% comment %}
  Install as sections/stellar-homepage-hero.liquid in a duplicate unpublished
  theme. Replace only the existing index hero; category strip is included.
  Load stellar-homepage.css once on index; retain existing fonts/header runtime.
{% endcomment %}
{% if request.page_type == 'index' %}
  <section class="stellar-home-hero" aria-labelledby="stellar-home-heading-{{ section.id }}">
    <div class="stellar-home-art" aria-hidden="true">
      <img src="{{ 'stellar-homepage-approved-photo.webp' | asset_url }}" alt="" width="1216" height="830" fetchpriority="high">
      <span class="stellar-home-formula">{{ section.settings.formula_note | escape }}</span>
    </div>
    <div class="stellar-home-copy">
      <h1 id="stellar-home-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      <span class="stellar-home-tagline">{{ section.settings.tagline | escape }}</span>
      <p>{{ section.settings.subtitle_line_1 | escape }}<br>{{ section.settings.subtitle_line_2 | escape }}</p>
      <a class="stellar-home-cta" href="{{ routes.root_url }}collections/products">{{ section.settings.cta_label | escape }}</a>
    </div>
  </section>
  <nav class="stellar-home-categories" aria-label="Browse product categories">
    <a href="{{ routes.root_url }}collections/whey-protein">Whey Proteins</a>
    <a href="{{ routes.root_url }}collections/vegan-bars">Vegan Protein</a>
    <a href="{{ routes.root_url }}collections/electrolytes">Electrolytes</a>
    <a href="{{ routes.root_url }}collections/supplements">Supplements</a>
  </nav>
{% endif %}
{% schema %}
{
  "name": "Stellar approved hero",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "LEAN NUTRITION" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Make Every Calorie Count" },
    { "type": "text", "id": "formula_note", "label": "Packaging note", "default": "New Look, Same Formula" },
    { "type": "text", "id": "subtitle_line_1", "label": "Subtitle line 1", "default": "High-protein shakes," },
    { "type": "text", "id": "subtitle_line_2", "label": "Subtitle line 2", "default": "electrolyte-rich hydration, and supplements." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "SHOP ALL PRODUCTS" }
  ],
  "presets": [{ "name": "Stellar approved hero" }]
}
{% endschema %}
